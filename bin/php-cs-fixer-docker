#!/usr/bin/env bash
# php-cs-fixer-docker — run php-cs-fixer inside a pinned Docker image.
#
# Usage: php-cs-fixer-docker <check|fix> [paths...] [-- extra php-cs-fixer flags]
#
# Exit status: 0 ok, 1 violations found (check), 2 tool/preflight error.
# php-cs-fixer's own dry-run "files need fixing" status (bit 8) maps to 1;
# every other non-zero php-cs-fixer status maps to 2.
set -u

# ---------------------------------------------------------------- constants
EXIT_OK=0
EXIT_VIOLATIONS=1
EXIT_TOOL_ERROR=2

# The ONLY place the image reference lives. Bumping it is a plugin release:
# update CHANGELOG.md "VERSION-IMAGE mapping" and .claude-plugin/plugin.json.
#
# The php-cs-fixer release is pinned; only the PHP suffix is resolved per run
# (see resolve_php_version). Upstream publishes this release for every PHP in
# PHP_SUPPORTED, so swapping the suffix never changes the fixer's own version.
IMAGE_BASE="ghcr.io/php-cs-fixer/php-cs-fixer:3.95.25"
PHP_SUPPORTED="7.4 8.0 8.1 8.2 8.3 8.4 8.5"
PHP_DEFAULT="8.5"
IMAGE=""   # IMAGE_BASE-php<resolved>, set by resolve_image

# Builtins only (no dirname): must work before PATH is validated by preflight.
_self="${BASH_SOURCE[0]}"
while [ -L "$_self" ]; do
    _target=$(readlink "$_self")
    case "$_target" in /*) _self="$_target" ;; *) _self="${_self%/*}/$_target" ;; esac
done
case "$_self" in */*) _self_dir="${_self%/*}" ;; *) _self_dir="." ;; esac
RUNNER_ROOT="$(cd -- "$_self_dir/.." && pwd -P)"
BUNDLED_CONFIG_HOST="$RUNNER_ROOT/config/default.php-cs-fixer.php"
BUNDLED_CONFIG_CONTAINER="/php-cs-fixer-plugin/default.php-cs-fixer.php"
BUNDLED_CONFIG_LABEL="bundled default (@Symfony, non-risky, short arrays)"

# Preflight cause messages: four distinct single-line causes (runner R8).
MSG_NO_DOCKER="docker CLI not found on PATH; install Docker"
MSG_NO_DAEMON="cannot reach the Docker daemon; is it running?"
MSG_NO_SCOPE="no scope: not inside a git repository and no path given; pass a path"
MSG_PULL_FAILED="failed to pull image"   # followed by the image and a hint, one line

DIFF_DELIMITER="--- diff ---"

# ---------------------------------------------------------------- helpers
usage() {
    cat >&2 <<'USAGE'
Usage: php-cs-fixer-docker <check|fix> [--php X.Y] [paths...] [-- extra php-cs-fixer flags]

  check   dry-run: list the files that would change, write nothing (exit 1 if any)
  fix     rewrite files in place

Paths default to the git working set (modified, staged, untracked .php files).
Anything after `--` is forwarded to php-cs-fixer verbatim; pass `-- --diff` to
append the unified diff after the summary.

--php (or PHPCSFIXER_PHP) picks the PHP the fixer runs on. Without it the
version is read from the project: composer.json config.platform.php, else the
floor of composer.json require.php, else .php-version, else the pinned default.
The php: line of every run says which version applied and where it came from.
USAGE
}

die() {
    printf 'error: %s\n' "$*" >&2
    exit "$EXIT_TOOL_ERROR"
}

# Map a php-cs-fixer exit status to this script's exit classes.
map_fixer_status() {
    local status=$1
    if [ "$status" -eq 0 ]; then
        echo "$EXIT_OK"
    elif [ $((status & 8)) -ne 0 ] && [ $((status & ~8)) -eq 0 ]; then
        echo "$EXIT_VIOLATIONS"
    else
        echo "$EXIT_TOOL_ERROR"
    fi
}

# Resolve the project root P: git top-level of $PWD, else $PWD itself.
resolve_project_root() {
    local top
    command -v git >/dev/null 2>&1 || die "git not found on PATH; install git"
    if top=$(git rev-parse --show-toplevel 2>/dev/null); then
        IN_GIT_REPO=1
        P="$top"
    else
        IN_GIT_REPO=0
        P="$PWD"
    fi
    P="$(cd -- "$P" && pwd -P)" || die "cannot enter project root: $P"
    case "$P" in *:*) die "project root path contains ':', which Docker bind mounts cannot express: $P" ;; esac
}

# Absolute, symlink-resolved path without depending on realpath(1) (absent on stock macOS).
abs_path() {
    local p=$1
    if [ -d "$p" ]; then
        (cd -- "$p" && pwd -P)
    else
        local dir base
        dir=$(dirname -- "$p"); base=$(basename -- "$p")
        (cd -- "$dir" && printf '%s/%s\n' "$(pwd -P)" "$base")
    fi
}

# ---------------------------------------------------------------- PHP version resolution (runner R10)
# php-cs-fixer parses with the PHP it runs on and executes the project's own
# .php-cs-fixer.php under it, so the runtime PHP is part of the result. The
# project decides it; the pinned default applies only when nothing says otherwise.

# Read one string value at a dotted path out of JSON, without jq or php.
# Paths are anchored from the root, so "require.php" never matches
# "require-dev.php" or "extra.require.php". Array elements are not addressable
# (no composer field we read lives in one).
json_string_at() { # json_string_at <file> <dotted.path>
    awk -v want="$2" '
        { s = s $0 "\n" }
        END {
            n = length(s); i = 1; depth = 0
            while (i <= n) {
                c = substr(s, i, 1)
                if (c == "\"") {
                    j = i + 1; str = ""
                    while (j <= n) {
                        ch = substr(s, j, 1)
                        if (ch == "\\") { str = str substr(s, j + 1, 1); j += 2; continue }
                        if (ch == "\"") break
                        str = str ch; j++
                    }
                    i = j + 1
                    k = i
                    while (k <= n && substr(s, k, 1) ~ /[ \t\r\n]/) k++
                    if (substr(s, k, 1) == ":") { key[depth] = str; i = k + 1; continue }
                    path = ""
                    for (d = 1; d <= depth; d++) path = (path == "" ? key[d] : path "." key[d])
                    if (path == want) { print str; exit }
                    continue
                }
                if (c == "{" || c == "[") { depth++; key[depth] = ""; i++; continue }
                if (c == "}" || c == "]") { depth--; i++; continue }
                i++
            }
        }' "$1" 2>/dev/null
}

# "8.1.7" -> 8.1, "8" -> 8.0. Empty when the string holds no version at all.
php_minor_of() {
    awk -v s="$1" 'BEGIN {
        if (!match(s, /[0-9]+(\.[0-9]+)*/)) exit
        v = substr(s, RSTART, RLENGTH)
        split(v, p, ".")
        printf "%d.%d\n", p[1], (p[2] == "" ? 0 : p[2])
    }'
}

# Lowest version a composer constraint admits: "^8.1" -> 8.1, "^7.4|^8.0" -> 7.4,
# ">=8.1 <9.0" -> 8.1. The declared floor is the contract the code must parse on.
php_minor_floor_of() {
    awk -v s="$1" 'BEGIN {
        best = ""
        while (match(s, /[0-9]+(\.[0-9]+)*/)) {
            v = substr(s, RSTART, RLENGTH); s = substr(s, RSTART + RLENGTH)
            split(v, p, ".")
            key = p[1] * 1000 + (p[2] == "" ? 0 : p[2])
            if (best == "" || key < best) { best = key; bestv = sprintf("%d.%d", p[1], (p[2] == "" ? 0 : p[2])) }
        }
        if (best != "") print bestv
    }'
}

php_is_supported() {
    case " $PHP_SUPPORTED " in *" $1 "*) return 0 ;; *) return 1 ;; esac
}

# Detected versions are clamped into the published range rather than failing a
# pull later: below the oldest tag -> oldest, above the newest -> newest,
# otherwise the next tag up. An explicitly requested version is never clamped
# (see resolve_php_version) — silently running something other than what the
# caller asked for would be worse than an error.
php_clamp() {
    awk -v want="$1" -v list="$PHP_SUPPORTED" 'BEGIN {
        n = split(list, a, " ")
        split(want, w, "."); wk = w[1] * 1000 + w[2]
        best = ""
        for (i = 1; i <= n; i++) {
            split(a[i], c, "."); ck = c[1] * 1000 + c[2]
            if (i == 1 || ck < mink) { mink = ck; minv = a[i] }
            if (i == 1 || ck > maxk) { maxk = ck; maxv = a[i] }
            if (ck >= wk && (best == "" || ck < bestk)) { bestk = ck; best = a[i] }
        }
        print (wk < mink ? minv : (wk > maxk ? maxv : best))
    }'
}

PHP_VERSION=""
PHP_SOURCE=""
resolve_php_version() {
    local raw="" source="" detected=""

    # Explicit request wins and is honoured exactly or not at all.
    if [ -n "$PHP_FLAG" ]; then
        raw=$PHP_FLAG; source="--php"
    elif [ -n "${PHPCSFIXER_PHP:-}" ]; then
        raw=$PHPCSFIXER_PHP; source="PHPCSFIXER_PHP"
    fi
    if [ -n "$raw" ]; then
        detected=$(php_minor_of "$raw")
        [ -n "$detected" ] || die "not a PHP version: $source=$raw (expected MAJOR.MINOR, e.g. 8.2)"
        php_is_supported "$detected" \
            || die "no published image for PHP $detected ($source=$raw); available: $PHP_SUPPORTED"
        PHP_VERSION=$detected; PHP_SOURCE=$source
        return
    fi

    # Project signals, strongest first: the exact platform composer resolves
    # against, then the declared floor of the php constraint, then .php-version.
    if [ -f "$P/composer.json" ]; then
        raw=$(json_string_at "$P/composer.json" config.platform.php)
        if [ -n "$raw" ]; then
            detected=$(php_minor_of "$raw"); source="composer.json config.platform.php"
        else
            raw=$(json_string_at "$P/composer.json" require.php)
            if [ -n "$raw" ]; then
                detected=$(php_minor_floor_of "$raw"); source="composer.json require.php"
            fi
        fi
    fi
    if [ -z "$detected" ] && [ -f "$P/.php-version" ]; then
        IFS= read -r raw < "$P/.php-version" || raw=""
        if [ -n "$raw" ]; then
            detected=$(php_minor_of "$raw"); source=".php-version"
        fi
    fi
    if [ -z "$detected" ]; then
        PHP_VERSION=$PHP_DEFAULT; PHP_SOURCE="pinned default"
        return
    fi

    PHP_VERSION=$(php_clamp "$detected")
    if [ "$PHP_VERSION" = "$detected" ]; then
        PHP_SOURCE="$source: $raw"
    else
        PHP_SOURCE="$source: $raw -> $detected clamped to $PHP_VERSION, the nearest published tag"
    fi
}

resolve_image() {
    IMAGE="$IMAGE_BASE-php$PHP_VERSION"
    # Self-test hook: tests/verify.sh provokes a pull failure by overriding the image.
    # Honoured only when PHPCSFIXER_SELFTEST=1 is also set, and always announced.
    if [ "${PHPCSFIXER_SELFTEST:-}" = "1" ] && [ -n "${PHPCSFIXER_IMAGE_OVERRIDE:-}" ]; then
        IMAGE="$PHPCSFIXER_IMAGE_OVERRIDE"
        printf 'warning: self-test image override active: %s\n' "$IMAGE" >&2
    fi
}

# ---------------------------------------------------------------- docker layer (runner R1, R2, R3)
# The single place a container is started. Mounts P at the identical absolute
# path and runs with P as workdir, so __DIR__, vendor/autoload.php and every path
# php-cs-fixer prints are host-valid. On Linux the process runs as the invoking
# uid:gid so rewritten files and .php-cs-fixer.cache keep the caller's ownership;
# on macOS Docker Desktop already maps ownership, so no --user is passed.
#
# --network=none: formatting never needs the network, and a project
# .php-cs-fixer.php is arbitrary PHP that php-cs-fixer executes with the project
# mounted read-write. Cutting egress makes "no run-time fetching" a property of
# the sandbox rather than a promise about the runner's own source.
run_fixer() {
    [ -f "$BUNDLED_CONFIG_HOST" ] || die "bundled config missing: $BUNDLED_CONFIG_HOST"
    # COLUMNS keeps php-cs-fixer's error text from wrapping paths at 80 chars.
    local -a docker_args=(run --rm --network=none -v "$P:$P" -w "$P" -e HOME=/tmp -e COLUMNS=200 -v "$BUNDLED_CONFIG_HOST:$BUNDLED_CONFIG_CONTAINER:ro")
    local uid gid
    case "$(uname -s)" in
        Darwin) ;;
        *)
            uid=$(id -u) && gid=$(id -g) || die "cannot determine uid/gid for the container user"
            docker_args+=(--user "$uid:$gid") ;;
    esac
    docker "${docker_args[@]}" "$IMAGE" "$@"
}

# ---------------------------------------------------------------- config resolution (runner R4)
# Detection order mirrors php-cs-fixer's own precedence (.php-cs-fixer.php beats
# .php-cs-fixer.dist.php).
CONFIG_ARGS=()
CONFIG_LABEL=""
resolve_config() {
    local a
    # --config is passed explicitly in every case: php-cs-fixer requires it
    # whenever more than one path is given.
    if [ -f "$P/.php-cs-fixer.php" ]; then
        CONFIG_ARGS=("--config=$P/.php-cs-fixer.php")
        CONFIG_LABEL="project ($P/.php-cs-fixer.php)"
    elif [ -f "$P/.php-cs-fixer.dist.php" ]; then
        CONFIG_ARGS=("--config=$P/.php-cs-fixer.dist.php")
        CONFIG_LABEL="project ($P/.php-cs-fixer.dist.php)"
    else
        CONFIG_ARGS=("--config=$BUNDLED_CONFIG_CONTAINER")
        CONFIG_LABEL="$BUNDLED_CONFIG_LABEL"
    fi
    # php-cs-fixer refuses --config together with --rules; a caller-supplied
    # --rules therefore replaces the resolved configuration, and the label says so.
    for a in "${PASSTHROUGH[@]+"${PASSTHROUGH[@]}"}"; do
        case "$a" in
            --rules|--rules=*)
                CONFIG_ARGS=()
                CONFIG_LABEL="none (caller --rules replaces: $CONFIG_LABEL)"
                break ;;
        esac
    done
}

# ---------------------------------------------------------------- scope resolution (runner R7)
SCOPE=()
EMPTY_SCOPE=0
resolve_scope() {
    if [ ${#PATHS[@]} -gt 0 ]; then
        local p abs
        for p in "${PATHS[@]}"; do
            [ -e "$p" ] || die "path does not exist: $p"
            abs=$(abs_path "$p") || die "cannot resolve path: $p"
            case "$abs" in
                "$P"|"$P"/*) SCOPE+=("$abs") ;;
                *) die "path is outside the project root: $p" ;;
            esac
        done
        return
    fi
    [ "$IN_GIT_REPO" -eq 1 ] || die "$MSG_NO_SCOPE"

    # Git working set: modified, staged, untracked .php files. -z keeps odd names
    # intact, -uall lists files inside untracked directories individually.
    local rec xy path
    while IFS= read -r -d '' rec; do
        xy=${rec:0:2}
        path=${rec:3}
        case "$xy" in
            R?|C?|?R|?C) IFS= read -r -d '' _ ;;   # rename/copy: drop the original-path field
        esac
        case "$xy" in
            D?|?D) continue ;;                     # deleted: nothing on disk to format
            *U*|AA) continue ;;                    # unmerged: conflict markers are not parseable PHP
        esac
        case "$path" in
            *.php) SCOPE+=("$P/$path") ;;
        esac
    done < <(git -c core.quotePath=false -C "$P" status --porcelain -z -uall)
    [ ${#SCOPE[@]} -gt 0 ] || EMPTY_SCOPE=1
}

# ---------------------------------------------------------------- preflight (runner R8)
preflight_docker() {
    command -v docker >/dev/null 2>&1 || die "$MSG_NO_DOCKER"
    docker info >/dev/null 2>&1 || die "$MSG_NO_DAEMON"
}

ensure_image() {
    docker image inspect "$IMAGE" >/dev/null 2>&1 && return
    docker pull "$IMAGE" >/dev/null 2>&1 \
        || die "$MSG_PULL_FAILED $IMAGE (run: docker pull $IMAGE)"
}

# ---------------------------------------------------------------- diff mode (runner R9)
# The summary is the changed-file list, not the diff: a diff of every violation
# is the single largest part of the output and an agent reader pays for it on
# every run. It is emitted only when the caller asks for it with `-- --diff`.
WANT_DIFF=0
resolve_diff_mode() {
    local a
    for a in "${PASSTHROUGH[@]+"${PASSTHROUGH[@]}"}"; do
        case "$a" in --diff) WANT_DIFF=1; break ;; esac
    done
}

# ---------------------------------------------------------------- summary (runner R9)
# Parses php-cs-fixer's text output. Formats verified against the pinned image:
#   "Found N of M files that can be fixed" / "Fixed N of M files"
#   "   1) src/Foo.php"           (file list, outside diff blocks)
#   "---------- begin diff ----------" ... "----------- end diff -----------"
print_summary() {
    local out=$1
    printf 'php: %s (%s)\n' "$PHP_VERSION" "$PHP_SOURCE"
    printf 'config: %s\n' "$CONFIG_LABEL"
    awk -v P="$P" -v want_diff="$WANT_DIFF" -v delim="$DIFF_DELIMITER" '
        /begin diff -+$/ { indiff = 1; next }
        /end diff -+$/   { indiff = 0; next }
        indiff           { diff = diff $0 "\n"; next }
        /^(Found|Fixed) [0-9]+ of [0-9]+ files/ { changed = $2; processed = $4; next }
        /^[[:space:]]*[0-9]+\) / { sub(/^[[:space:]]*[0-9]+\) /, ""); sub(/ \([^)]*\)$/, "")
                                   if ($0 !~ /^\//) $0 = P "/" $0
                                   files = files $0 "\n"; next }
        END {
            printf "files_processed: %d\nfiles_changed: %d\n", processed, changed
            printf "%s", files
            if (want_diff == 1 && changed > 0) { print delim; printf "%s", diff }
        }' "$out"
}

# ---------------------------------------------------------------- operations (runner R5, R6)
run_operation() {
    local -a args=(fix --show-progress=none)
    # No --diff by default: the caller gets it by passing `-- --diff`, which
    # lands in PASSTHROUGH below and switches WANT_DIFF on.
    [ "$OPERATION" = "check" ] && args+=(--dry-run)
    args+=("${CONFIG_ARGS[@]+"${CONFIG_ARGS[@]}"}")
    # Caller flags go last so they override runner defaults (last wins).
    args+=("${PASSTHROUGH[@]+"${PASSTHROUGH[@]}"}")
    args+=(-- "${SCOPE[@]}")

    local out status mapped
    out=$(mktemp "${TMPDIR:-/tmp}/php-cs-fixer-docker.XXXXXX") || die "cannot create temp file"
    trap 'rm -f "$out"' EXIT
    run_fixer "${args[@]}" >"$out" 2>&1
    status=$?
    mapped=$(map_fixer_status "$status")
    if [ "$mapped" -eq "$EXIT_TOOL_ERROR" ]; then
        # Tool failure: php-cs-fixer's own output, verbatim, no runner commentary.
        cat "$out" >&2
        exit "$EXIT_TOOL_ERROR"
    fi
    # Caller asked php-cs-fixer for verbosity: show its raw output (stderr),
    # then the fixed-shape summary (stdout).
    local a
    for a in "${PASSTHROUGH[@]+"${PASSTHROUGH[@]}"}"; do
        case "$a" in -v|-vv|-vvv|--verbose) cat "$out" >&2; break ;; esac
    done
    print_summary "$out"
    exit "$mapped"
}

# ---------------------------------------------------------------- argument parsing
OPERATION=""
PATHS=()
PASSTHROUGH=()
PHP_FLAG=""

parse_args() {
    if [ $# -eq 0 ]; then
        usage
        exit "$EXIT_TOOL_ERROR"
    fi
    case "$1" in
        check|fix) OPERATION=$1 ;;
        -h|--help) usage; exit "$EXIT_OK" ;;
        *) usage; die "unknown operation: $1" ;;
    esac
    shift
    while [ $# -gt 0 ]; do
        case "$1" in
            --)
                shift
                PASSTHROUGH=("$@")
                break ;;
            --php=*)
                PHP_FLAG=${1#--php=}; shift; continue ;;
            --php)
                [ $# -ge 2 ] || die "--php needs a version, e.g. --php 8.2"
                PHP_FLAG=$2; shift 2; continue ;;
        esac
        PATHS+=("$1")
        shift
    done
    # --php selects the container, so php-cs-fixer never sees it: after `--` it
    # would reach php-cs-fixer as an unknown option instead of doing anything.
    local a
    for a in "${PASSTHROUGH[@]+"${PASSTHROUGH[@]}"}"; do
        case "$a" in
            --php|--php=*) die "--php selects the PHP version and belongs before '--', not after it" ;;
        esac
    done
}

# ---------------------------------------------------------------- main
main() {
    parse_args "$@"
    resolve_project_root
    resolve_php_version
    resolve_image

    if [ "${PHPCSFIXER_DEBUG_ARGS:-}" = "1" ]; then
        printf 'operation=%s\nP=%s\nin_git=%s\nimage=%s\nphp=%s\nphp_source=%s\n' \
            "$OPERATION" "$P" "$IN_GIT_REPO" "$IMAGE" "$PHP_VERSION" "$PHP_SOURCE"
        printf 'path=%s\n' "${PATHS[@]+"${PATHS[@]}"}"
        printf 'passthrough=%s\n' "${PASSTHROUGH[@]+"${PASSTHROUGH[@]}"}"
        exit "$EXIT_OK"
    fi

    # Preflight order (runner R8): docker CLI -> daemon -> scope/paths -> image.
    # Nothing below starts a container or touches a project file until all pass.
    preflight_docker
    resolve_scope
    resolve_config
    resolve_diff_mode
    if [ "$EMPTY_SCOPE" -eq 1 ]; then
        print_summary /dev/null
        exit "$EXIT_OK"
    fi
    ensure_image
    run_operation
}

main "$@"
